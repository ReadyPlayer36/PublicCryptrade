{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "matrix_integrity",
    "status",
    "stage_definition",
    "documents",
    "source_citation_policy",
    "network",
    "finality",
    "retry",
    "cooldown",
    "storage",
    "hash",
    "coverage",
    "observations",
    "acceptance_rows",
    "tooling",
    "freeze",
    "risk_register",
    "evidence_classes",
    "mutation_killers",
    "changelog_v22",
    "changelog_v23",
    "changelog_v24",
    "changelog_v25",
    "changelog_v26",
    "changelog_v27",
    "changelog_v28",
    "changelog_v29"
  ],
  "properties": {
    "schema_version": {
      "const": "2.9"
    },
    "status": {
      "type": "object",
      "required": [
        "milestone_1",
        "milestone_1_2"
      ],
      "additionalProperties": false,
      "properties": {
        "milestone_1": {
          "type": "string"
        },
        "milestone_1_2": {
          "type": "string"
        }
      }
    },
    "documents": {
      "type": "object",
      "required": [
        "M1",
        "M1_2"
      ],
      "additionalProperties": false,
      "properties": {
        "M1": {
          "$ref": "#/$defs/document"
        },
        "M1_2": {
          "$ref": "#/$defs/document"
        }
      }
    },
    "source_citation_policy": {
      "type": "object"
    },
    "network": {
      "type": "object"
    },
    "finality": {
      "type": "object"
    },
    "retry": {
      "type": "object"
    },
    "cooldown": {
      "type": "object"
    },
    "storage": {
      "type": "object"
    },
    "hash": {
      "type": "object"
    },
    "coverage": {
      "type": "object"
    },
    "observations": {
      "type": "object"
    },
    "acceptance_rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/row"
      }
    },
    "tooling": {
      "type": "object"
    },
    "freeze": {
      "type": "object"
    },
    "risk_register": {
      "type": "object"
    },
    "evidence_classes": {
      "type": "object"
    },
    "mutation_killers": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string",
          "pattern": "^tests/(unit|integration|security|tools|observations|live|ci|mutation)/[^:]+::[A-Za-z_][A-Za-z0-9_]*(?:\\[[^]]+\\])?$"
        }
      }
    },
    "changelog_v22": {
      "type": "array"
    },
    "changelog_v23": {
      "type": "array"
    },
    "changelog_v24": {
      "type": "array"
    },
    "changelog_v25": {
      "type": "array"
    },
    "changelog_v26": {
      "type": "array"
    },
    "changelog_v27": {
      "type": "array"
    },
    "matrix_integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_acceptance_rows"
      ],
      "properties": {
        "expected_acceptance_rows": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "stage_definition": {
      "type": "string",
      "minLength": 1
    },
    "changelog_v28": {
      "type": "array"
    },
    "changelog_v29": {
      "type": "array"
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "format",
        "sections"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "const": "markdown"
        },
        "sections": {
          "type": "object"
        },
        "comparison": {
          "type": "string"
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "mandatory",
        "labels",
        "requirement",
        "source_citations",
        "tests",
        "artifact_path",
        "evidence_class",
        "stage"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "mandatory": {
          "type": "boolean"
        },
        "labels": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "requirement": {
          "type": "string"
        },
        "source_citations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^tests/(unit|integration|security|tools|observations|live|ci|mutation)/[^:]+::[A-Za-z_][A-Za-z0-9_]*(?:\\[[^]]+\\])?$"
          },
          "minItems": 1
        },
        "artifact_path": {
          "type": "string",
          "minLength": 1
        },
        "evidence_class": {
          "enum": [
            "offline",
            "ci",
            "live"
          ]
        },
        "stage": {
          "enum": [
            1,
            2
          ]
        },
        "source_item_bindings": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^\\[(M1|1\\.2) §(28|5) #\\d+\\]$": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^tests/(unit|integration|security|tools|observations|live|ci|mutation)/[^:]+::[A-Za-z_][A-Za-z0-9_]*(?:\\[[^]]+\\])?$"
              }
            }
          }
        }
      }
    }
  }
}
